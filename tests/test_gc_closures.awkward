fn make_adder(x) {
    return lambda y: x + y;
}

let add10 = make_adder(10);

let closures = [];
let i = 0;
while (i < 3) {
    closures.append(make_adder(i));
    i = i + 1;
}

let j = 0;
while (j < 3000) {
    let tmp = j + 1;
    j = j + 1;
}

print(j);
print(add10.call(5));

let k = 0;
while (k < 3) {
    print(closures[k].call(5));
    k = k + 1;
}
