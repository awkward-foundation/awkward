#!/bin/sh

set -e

SELF_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

if [ -d "$SELF_DIR/lib" ]; then
    LIBDIR="$SELF_DIR/lib"
else
    LIBDIR="${AWKWARD_LIBDIR:-/usr/local/lib/awkward}"
fi

export LC_ALL=C

ALL_MODULES="math system io fs http regex kek mysql"

TARGET=""
for arg in "$@"; do
    case "$arg" in
        -*) ;;
        *) TARGET="$arg"; break ;;
    esac
done

NEEDED=""
SEEN_FILES=""

scan_file() {
    file="$1"
    if [ ! -f "$file" ]; then
        if [ -n "$LIBDIR" ] && [ -f "$LIBDIR/$file" ]; then
            file="$LIBDIR/$file"
        else
            return 0
        fi
    fi
    case " $SEEN_FILES " in
        *" $file "*) return 0 ;;
    esac
    SEEN_FILES="$SEEN_FILES $file"

    names=$(sed -n 's/^[[:space:]]*import[[:space:]][[:space:]]*\([A-Za-z_][A-Za-z0-9_.]*\).*/\1/p' "$file")
    for name in $names; do
        case " $ALL_MODULES " in
            *" $name "*)
                case " $NEEDED " in
                    *" $name "*) ;;
                    *) NEEDED="$NEEDED $name" ;;
                esac
                ;;
            *)
                modfile=$(echo "$name" | tr '.' '/')
                scan_file "$modfile.awkward"
                ;;
        esac
    done
}

[ -n "$TARGET" ] && scan_file "$TARGET"

FILES="-f $LIBDIR/core.awk"
for m in $ALL_MODULES; do
    case " $NEEDED " in
        *" $m "*) FILES="$FILES -f $LIBDIR/modules/$m.awk" ;;
    esac
done

exec awk $FILES -v AWKWARD_LIBDIR="$LIBDIR" -- "$@"
